{
  "name": "peppered-save-manager",
  "version": "1.0.0",
  "description": "A safe bilingual checkpoint manager for PEPPERED save files.",
  "main": "out/main/index.js",
  "author": "PEPPERED Save Manager contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "npm run build && node scripts/electron-smoke.mjs",
    "test:windows-helper": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-replace-smoke.ps1",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.18.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "io.github.wdn2010.peppered-save-manager",
    "productName": "PEPPERED Save Manager",
    "asar": true,
    "files": [
      "out/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/replace-save.ps1",
        "to": "helpers/replace-save.ps1"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PEPPERED-Save-Manager-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "PEPPERED-Save-Manager-${version}-portable.exe"
    }
  }
}
