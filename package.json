{
  "name": "peppered-save-manager",
  "version": "1.0.0",
  "description": "A safe bilingual checkpoint manager for PEPPERED save files.",
  "main": "out/main/index.js",
  "author": "PEPPERED Save Manager contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@vitejs/plugin-react": "4.3.4",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "electron": "34.3.3",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "com.mostlygames.peppered.save-manager",
    "productName": "PEPPERED Save Manager",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PEPPERED-Save-Manager-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "PEPPERED-Save-Manager-${version}-portable.exe"
    }
  }
}
