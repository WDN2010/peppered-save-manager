{
  "name": "peppered-save-manager",
  "version": "1.0.6",
  "description": "A safe bilingual checkpoint manager for PEPPERED save files.",
  "main": "out/main/index.js",
  "author": "PEPPERED Save Manager contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "npm run build && node scripts/electron-smoke.mjs",
    "test:windows-save-lock": "npm run build && node scripts/windows-save-lock-smoke.mjs",
    "test:windows-helper": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-replace-smoke.ps1",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "io.github.wdn2010.peppered-save-manager",
    "productName": "PEPPERED Save Manager",
    "asar": true,
    "files": [
      "out/**/*",
      "build/icon.ico",
      "LICENSE",
      "NOTICE.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/replace-save.ps1",
        "to": "helpers/replace-save.ps1"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.peppered-save-manager.txt"
      },
      {
        "from": "NOTICE.md",
        "to": "NOTICE.peppered-save-manager.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PEPPERED-Save-Manager-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "PEPPERED-Save-Manager-${version}-portable.exe"
    }
  }
}
